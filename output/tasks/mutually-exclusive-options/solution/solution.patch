+    def check_mutually_exclusive(self, ctx: Context) -> None:
+        """Fail if the user provided more than one parameter of a
+        :attr:`mutually_exclusive` group.
+
+        A parameter counts as provided when its value came from the command
+        line, an environment variable or a prompt.
+
+        :raise TypeError: A group names a parameter the command does not have.
+        :raise UsageError: Two or more parameters of a group were provided.
+
+        .. versionadded:: 8.6
+        """
+        if not self.mutually_exclusive:
+            return
+
+        params = {param.name: param for param in self.get_params(ctx) if param.name}
+
+        for group in self.mutually_exclusive:
+            unknown = [name for name in group if name not in params]
+
+            if unknown:
+                raise TypeError(
+                    f"Command {self.name!r} has no parameter named"
+                    f" {', '.join(map(repr, unknown))} for mutually_exclusive."
+                )
+
+            provided = []
+
+            for name in group:
+                source = ctx.get_parameter_source(name)
+
+                if source is not None and source < ParameterSource.DEFAULT_MAP:
+                    provided.append(params[name].get_error_hint(ctx))
+
+            if len(provided) > 1:
+                names = f"{', '.join(provided[:-1])} and {provided[-1]}"
+                raise UsageError(
+                    _("Parameters {names} cannot be used together.").format(
+                        names=names
+                    ),
+                    ctx=ctx,
+                )
+
